# Copiez ce fichier vers .env.production. Ne placez aucun secret ici.
COMPOSE_PROJECT_NAME=proxmox-vm-portal
PORTAL_IMAGE=proxmox-vm-portal:0.6.0
PORTAL_DOMAIN=portal.example.com
ACME_EMAIL=admin@example.com

PVE_API_URL=https://pve.example.com:8006/api2/json
PVE_TOKEN_ID=portal@pve!provisioning
PORTAL_ADMIN_USERNAME=admin
PORTAL_LOCAL_AUTH_ENABLED=true

# Keycloak externe : renseignez les quatre valeurs et le secret dédié.
PORTAL_OIDC_ISSUER=
PORTAL_OIDC_CLIENT_ID=
PORTAL_OIDC_REDIRECT_URI=
PORTAL_OIDC_ROLE_ADMIN=portal-admin
PORTAL_OIDC_ROLE_OPERATOR=portal-operator
PORTAL_OIDC_ROLE_USER=portal-user

# Password Pusher externe ou profil interne après création de son API token.
PORTAL_PWPUSH_URL=
PORTAL_PWPUSH_EXPIRE_DAYS=1
PORTAL_PWPUSH_EXPIRE_VIEWS=1

# Services internes optionnels : keycloak, pwpush ou keycloak,pwpush.
COMPOSE_PROFILES=
KEYCLOAK_DOMAIN=id.example.com
KEYCLOAK_ADMIN_USERNAME=portal-admin
PWPUSH_DOMAIN=pwpush.example.com

# Destinataire age obligatoire pour les sauvegardes (age1...).
BACKUP_AGE_RECIPIENT=
BACKUP_DIRECTORY=/var/backups/proxmox-vm-portal
