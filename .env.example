# Copier vers .env localement, ne jamais versionner .env.
# Compte de service PVE dédié, avec privilèges minimaux (jamais root@pam).
PVE_API_URL=https://pve.example.internal:8006/api2/json
PVE_TOKEN_ID=portal@pve!provisioner
PVE_TOKEN_SECRET=CHANGE_ME_LOCAL_ONLY

# Compte local MVP. Ne mettez jamais le mot de passe en clair.
PORTAL_ADMIN_USERNAME=admin
# Générer localement: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('choisir-un-mot-de-passe-fort'))"
PORTAL_ADMIN_PASSWORD_HASH=GENERATE_A_LOCAL_PASSWORD_HASH
# Générer localement: python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTAL_SESSION_SECRET=GENERATE_A_LOCAL_SESSION_SECRET
# true par défaut. Ne définir false que pour un développement local HTTP isolé.
PORTAL_SESSION_COOKIE_SECURE=true
