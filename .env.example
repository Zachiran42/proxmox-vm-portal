# Copier vers .env localement, ne jamais versionner .env.
# Compte de service PVE dédié, avec privilèges minimaux (jamais root@pam).
PVE_API_URL=https://pve.example.internal:8006/api2/json
PVE_TOKEN_ID=portal@pve!provisioner
PVE_TOKEN_SECRET=CHANGE_ME_LOCAL_ONLY

# PostgreSQL dédié au portail. Utilisez un mot de passe aléatoire et encodez les
# caractères réservés dans l'URL. SQLite n'est prévu que pour le développement.
PORTAL_DATABASE_URL=postgresql+psycopg://portal:CHANGE_ME_LOCAL_ONLY@postgres:5432/portal

# Premier compte local, créé une seule fois avec `flask bootstrap-admin` après
# la migration. Ne mettez jamais le mot de passe en clair.
PORTAL_ADMIN_USERNAME=admin
# Générer localement: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('choisir-un-mot-de-passe-fort'))"
PORTAL_ADMIN_PASSWORD_HASH=GENERATE_A_LOCAL_PASSWORD_HASH
# Générer localement: python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTAL_SESSION_SECRET=GENERATE_A_LOCAL_SESSION_SECRET
# true par défaut. Ne définir false que pour un développement local HTTP isolé.
PORTAL_SESSION_COOKIE_SECURE=true
PORTAL_LOGIN_MAX_FAILURES=5
PORTAL_LOGIN_IP_MAX_FAILURES=25
PORTAL_LOGIN_WINDOW_SECONDS=900

# Worker de provisionnement. Lancez au moins une instance avec
# `flask --app 'portal:create_app' worker`. PostgreSQL arbitre les travaux si
# plusieurs workers sont exécutés.
PORTAL_JOB_POLL_SECONDS=5
PORTAL_JOB_LEASE_SECONDS=300

# Password Pusher v2 : URL interne auto-hébergée ou service externe au choix.
# Laisser URL et token vides désactive les profils cloud-init. HTTPS est imposé.
PORTAL_PWPUSH_URL=https://pwpush.example.internal
PORTAL_PWPUSH_API_TOKEN=CHANGE_ME_LOCAL_ONLY
# Chemin vers la CA interne si elle n'est pas dans le trust store du système.
PORTAL_PWPUSH_CA_BUNDLE=
PORTAL_PWPUSH_EXPIRE_DAYS=1
PORTAL_PWPUSH_EXPIRE_VIEWS=1

# OIDC/Keycloak. Les quatre premières valeurs doivent être toutes renseignées
# ou toutes laissées vides. Désactivez le mode local après validation de l'OIDC.
PORTAL_LOCAL_AUTH_ENABLED=true
PORTAL_OIDC_ISSUER=https://id.example.internal/realms/proxmox-portal
PORTAL_OIDC_CLIENT_ID=proxmox-vm-portal
PORTAL_OIDC_CLIENT_SECRET=CHANGE_ME_LOCAL_ONLY
PORTAL_OIDC_REDIRECT_URI=https://portal.example.internal/auth/oidc/callback
PORTAL_OIDC_ROLE_ADMIN=portal-admin
PORTAL_OIDC_ROLE_OPERATOR=portal-operator
PORTAL_OIDC_ROLE_USER=portal-user
PORTAL_OIDC_DEFAULT_QUOTA_VMS=3
PORTAL_OIDC_DEFAULT_QUOTA_CPU=8
PORTAL_OIDC_DEFAULT_QUOTA_RAM_MB=16384
PORTAL_OIDC_DEFAULT_QUOTA_DISK_GB=200
